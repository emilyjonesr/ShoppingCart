{
  "manifest_version": 3,
  "name": "ShoppingCart",
  "version": "1.0",
  "description": "Universal Shopping Cart",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/detection.js",
        "src/storage.js",
        "src/ui.js",
        "src/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
